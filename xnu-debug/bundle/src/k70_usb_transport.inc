  }
  m.Status.ValidFields |= K70_USB_VALID_SCAN;
  m.Status.SmmuSmr = m.Status.BroadMatches != 0 ? BroadSmr : ExactSmr;
  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: SID40 exact=%u broad=%u SMR=%08x route=%08x",
    m.Status.ExactMatches, m.Status.BroadMatches, m.Status.SmmuSmr, Route);
  Message (Line);
  if ((m.Status.BroadMatches != 0) || (m.Status.ExactMatches != 1)) {
    AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: SID40 refused: exact=%u broad=%u SMR=%08x; untouched",
      m.Status.ExactMatches, m.Status.BroadMatches, m.Status.SmmuSmr);
    Fail (EFI_UNSUPPORTED, Line);
    return FALSE;
  }
  m.Status.SmmuRoute = Route;
  m.Status.ValidFields |= K70_USB_VALID_ROUTE;
  m.Status.SmmuCbar = 0;
  m.Status.SmmuSctlr = 1;
  if (((Route >> 16) & 3U) == 0) {
    Cb = Route & 255U;
    if (Cb >= 70) {
      Fail (EFI_UNSUPPORTED, "K70 XNU USB: SID40 context bank out of known bounds; untouched"); return FALSE;
    }
    m.Status.SmmuCbar = ReadAt (SMMU_BASE, 0x1000 + 4 * Cb);
    m.Status.SmmuSctlr = ReadAt (SMMU_BASE, 0x80000 + 0x1000 * Cb);
    m.Status.ValidFields |= K70_USB_VALID_CONTEXT;
  }
  if (!K70UsbRouteIdentity (Route, m.Status.SmmuCbar, m.Status.SmmuSctlr)) {
    AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: SID40 not identity: route=%08x CBAR=%08x SCTLR=%08x",
      Route, m.Status.SmmuCbar, m.Status.SmmuSctlr);
    Fail (EFI_UNSUPPORTED, Line);
    return FALSE;
  }
  return TRUE;
}

STATIC EFI_STATUS K70UsbCdcInitialize (K70_USB_COPY_LOG CopyLog, K70_USB_LOG_MESSAGE LogMessage)
{
  EFI_STATUS Status;
  UINT32 Hardware;
  UINT64 Ctr;
  UINTN Count;
  CHAR8 Line[192];
  if ((CopyLog == NULL) || (LogMessage == NULL)) { return EFI_INVALID_PARAMETER; }
  if (m.Attempted) { return EFI_ALREADY_STARTED; }
  m.Attempted = TRUE;
  m.CopyLog = CopyLog;
  m.LogMessage = LogMessage;
  m.Status.LastStatus = EFI_NOT_READY;
  m.Status.ShutdownStatus = EFI_NOT_STARTED;
  m.MaxPacket = 512;
  m.LineCoding[1] = 0xC2; m.LineCoding[2] = 1; m.LineCoding[6] = 8;
  Message ("K70 XNU USB: kernel-owned CDC K70XNU001; log-only; no commands");
  Status = MapKernelDevices ();
  if (EFI_ERROR (Status)) {
    Fail (Status, "K70 XNU: kernel device ioremap failed; untouched");
    return Status;
  }
  __asm__ __volatile__ ("mrs %0, ctr_el0" : "=r" (Ctr));
  m.Status.CacheLineBytes = 4U << ((Ctr >> 16) & 15U);
  m.Status.ValidFields |= K70_USB_VALID_CACHE;
  if ((m.Status.CacheLineBytes == 0) || (m.Status.CacheLineBytes > 64) ||
      ((m.Status.CacheLineBytes & (m.Status.CacheLineBytes - 1U)) != 0)) {
    Fail (EFI_UNSUPPORTED, "K70 XNU USB: cache line exceeds independent 64-byte DMA slots; untouched");
    return m.Status.LastStatus;
  }
  m.Status.GccPower = ReadAt (GCC_BASE, 4);
  m.Status.GccMaster = ReadAt (GCC_BASE, 0x18);
  m.Status.GccCfg = ReadAt (GCC_BASE, 0x88);
  m.Status.GccAggre = ReadAt (GCC_BASE, 0x8C);
  m.Status.ValidFields |= K70_USB_VALID_GCC;
  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: GCC power=%08x master=%08x cfg=%08x aggre=%08x",
    m.Status.GccPower, m.Status.GccMaster, m.Status.GccCfg, m.Status.GccAggre);
  Message (Line);
  if (!K70UsbGccReady (m.Status.GccPower, m.Status.GccMaster, m.Status.GccCfg, m.Status.GccAggre)) {
    Fail (EFI_NOT_READY, "K70 XNU USB: ABL clock/power state unavailable; controller untouched");
    return m.Status.LastStatus;
  }
  m.Status.SnpsId = ReadUsb (0xC120);
  Hardware = ReadUsb (0xC140);
  m.Status.DmaAddressWidth = Hardware >> 24;
  m.Status.Gctl = ReadUsb (GCTL);
  m.Status.ValidFields |= K70_USB_VALID_CONTROLLER;
  if ((((m.Status.SnpsId >> 16) != 0x5533) && ((m.Status.SnpsId >> 16) != 0x3331)) ||
      (((m.Status.Gctl >> 12) & 3U) != 2) ||
      (m.Status.DmaAddressWidth < 32) || (m.Status.DmaAddressWidth > 64)) {
    Fail (EFI_UNSUPPORTED, "K70 XNU USB: controller ID/device role/AWIDTH refused; untouched");
    return m.Status.LastStatus;
  }
  if (!CheckSmmu ()) { return m.Status.LastStatus; }
  m.Status.DstsBefore = ReadUsb (DSTS);
  m.Status.DctlBefore = ReadUsb (DCTL);
  m.Status.DstsAfter = ReadUsb (DSTS);
  m.Status.ValidFields |= K70_USB_VALID_IDLE;
  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: idle DSTS=%08x DCTL=%08x DSTS=%08x",
    m.Status.DstsBefore, m.Status.DctlBefore, m.Status.DstsAfter);
  Message (Line);
  if (((m.Status.DstsBefore & HALTED) == 0) || ((m.Status.DstsAfter & HALTED) == 0) ||
      ((m.Status.DctlBefore & RUN) != 0)) {
    Fail (EFI_NOT_READY, "K70 XNU USB: ABL controller is active/non-idle; controller untouched");
    return m.Status.LastStatus;
  }
  Status = AllocateDma ();
  if (EFI_ERROR (Status)) {
    Fail (Status, "K70 XNU USB: owned kernel BSS DMA validation failed; untouched");
    return Status;
  }
  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: DMA kernel BSS %llx+%x, contiguous owned pages, AWIDTH=%u",
    (unsigned long long)m.Status.DmaAddress, K70_USB_DMA_SIZE, m.Status.DmaAddressWidth);
  Message (Line);
  m.ControllerTouched = TRUE;
  Status = StopEngine ();
  if (EFI_ERROR (Status)) {
    Fail (Status, "K70 XNU USB: initial controller halt timeout"); return Status;
  }
  WriteUsb (DCTL, RESET);
  for (Count = 0; Count < HALT_POLLS; Count++) {
    if ((ReadUsb (DCTL) & RESET) == 0) { break; }
    MicroSecondDelay (1000);
  }
  if ((ReadUsb (DCTL) & RESET) != 0) {
    Fail (EFI_TIMEOUT, "K70 XNU USB: controller reset timeout"); return EFI_TIMEOUT;
  }
  WriteUsb (GEVNTADRLO, (UINT32)m.Status.DmaAddress);
  WriteUsb (GEVNTADRHI, (UINT32)(m.Status.DmaAddress >> 32));
  WriteUsb (GEVNTSIZ, (1U << 31) | EVENT_BYTES);
  if ((ReadUsb (GEVNTADRLO) != (UINT32)m.Status.DmaAddress) ||
      (ReadUsb (GEVNTADRHI) != (UINT32)(m.Status.DmaAddress >> 32)) ||
      (ReadUsb (GEVNTSIZ) != ((1U << 31) | EVENT_BYTES))) {
    Fail (EFI_DEVICE_ERROR, "K70 XNU USB: event DMA LO/HI/size readback mismatch"); return EFI_DEVICE_ERROR;
  }
  WriteUsb (GEVNTCOUNT, ReadUsb (GEVNTCOUNT) & 0xFFFFU);
  WriteUsb (DCFG, ReadUsb (DCFG) & ~(7U | (127U << 3)));
  if (!Command (0, START_CONFIG, 0, 0, 0) ||
      !Command (0, SET_CONFIG, 64U << 3, (1U << 8) | (1U << 10), 0) || !Command (0, SET_RESOURCE, 1, 0, 0) ||
      !Command (1, SET_CONFIG, 64U << 3, (1U << 8) | (1U << 10) | (1U << 25), 0) || !Command (1, SET_RESOURCE, 1, 0, 0)) {
    return m.Status.LastStatus;
  }
  WriteUsb (DALEPENA, 3);
  ArmSetup ();
  if (m.Status.Failed) { return m.Status.LastStatus; }
  m.OriginalHsOverride = ReadAt (QSCRATCH_BASE, 0x10);
  m.OriginalSsOverride = ReadAt (QSCRATCH_BASE, 0x30);
  m.OverrideWritten = TRUE;
  WriteAt (QSCRATCH_BASE, 0x10, m.OriginalHsOverride | (1U << 20) | (1U << 28));
  WriteAt (QSCRATCH_BASE, 0x30, m.OriginalSsOverride | (1U << 24));
  WriteUsb (DEVTEN, 7U | (1U << 9) | (1U << 11));
  WriteUsb (DCTL, ReadUsb (DCTL) | RUN);
  m.Status.Halted = FALSE;
  for (Count = 0; Count < HALT_POLLS; Count++) {
    if ((ReadUsb (DSTS) & HALTED) == 0) { break; }
    MicroSecondDelay (1000);
  }
  if ((ReadUsb (DSTS) & HALTED) != 0) {
    Fail (EFI_TIMEOUT, "K70 XNU USB: controller run timeout"); return EFI_TIMEOUT;
  }
  m.Status.Initialized = TRUE;
  m.Status.Running = TRUE;
  m.Status.LastStatus = EFI_SUCCESS;
  AsciiStrCpyS (m.Status.LastMessage, sizeof (m.Status.LastMessage), "K70 XNU USB: running; awaiting CDC enumeration and DTR");
  Message (m.Status.LastMessage);
  return EFI_SUCCESS;
}

STATIC VOID K70UsbCdcPoll (VOID)
{
  UINTN Available;
  UINTN Bytes;
  UINTN Offset;
  UINT32 Event;
  if (!m.Status.Running || m.Status.Failed || m.InPoll || m.InLog) { return; }
  m.InPoll = TRUE;
  Available = ReadUsb (GEVNTCOUNT) & 0xFFFFU;
  if ((Available > EVENT_BYTES) || ((Available & 3U) != 0)) {
    Fail (EFI_DEVICE_ERROR, "K70 XNU USB: invalid event ring count/alignment");
    m.InPoll = FALSE;
    return;
  }
  Bytes = MIN (Available, EVENT_BUDGET * 4U);
  if (Bytes != 0) {
    ReadDma (0, EVENT_BYTES);
    for (Offset = 0; Offset < Bytes; Offset += 4) {
      Event = *(volatile UINT32 *)(m.Dma + m.EventPosition);
      m.EventPosition = (m.EventPosition + 4) % EVENT_BYTES;
      m.Status.Events++;
      HandleEvent (Event);
      if (m.Status.Failed) { break; }
    }
    /* Only acknowledge consumed entries; leave excess for the next pump. */
    if (!m.Status.Failed) { WriteUsb (GEVNTCOUNT, Bytes); }
  }
  if (!m.Status.Failed) { Transmit (); }
  m.InPoll = FALSE;
}
