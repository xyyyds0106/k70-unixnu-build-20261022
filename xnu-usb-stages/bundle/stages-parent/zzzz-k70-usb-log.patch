+  UINTN Offset;
+  UINT64 Physical;
+  UINT64 TrbPhysical;
+  volatile UINT32 *Trb;
+  if (m.Status.Failed) {
+    return;
+  }
+  if ((Ep >= 6) || m.Busy[Ep] || (Buffer > K70_USB_DMA_SIZE) ||
+      (Length > K70_USB_DMA_SIZE - Buffer)) {
+    Fail (EFI_COMPROMISED_DATA, "K70 XNU USB: transfer ownership/bounds error");
+    return;
+  }
+  Offset = mTrbOffset[Ep];
+  Physical = m.Status.DmaAddress + Buffer;
+  TrbPhysical = m.Status.DmaAddress + Offset;
+  Trb = (volatile UINT32 *)(m.Dma + Offset);
+  Trb[0] = (UINT32)Physical;
+  Trb[1] = (UINT32)(Physical >> 32);
+  Trb[2] = (UINT32)Length;
+  Trb[3] = Kind | TRB_FLAGS;
+  m.Requested[Ep] = Length;
+  /* Clean before handing buffers/TRBs to hardware. Slots use separate lines. */
+  CleanDma (Buffer, Length);
+  CleanDma (Offset, 64);
+  m.Busy[Ep] = TRUE;
+  (VOID)Command (Ep, START, (UINT32)(TrbPhysical >> 32), (UINT32)TrbPhysical, 0);
+}
+
+STATIC BOOLEAN Complete (UINTN Ep, UINTN *Length)
+{
+  volatile UINT32 *Trb;
+  UINTN Left;
+  if ((Ep >= 6) || !m.Busy[Ep]) {
+    Fail (EFI_COMPROMISED_DATA, "K70 XNU USB: unexpected transfer completion");
+    return FALSE;
+  }
+  ReadDma (mTrbOffset[Ep], 64);
+  Trb = (volatile UINT32 *)(m.Dma + mTrbOffset[Ep]);
+  Left = Trb[2] & 0xFFFFFFU;
+  if (((Trb[3] & HWO) != 0) || ((Trb[2] >> 28) != 0) || (Left > m.Requested[Ep])) {
+    Fail (EFI_DEVICE_ERROR, "K70 XNU USB: invalid DMA completion");
+    return FALSE;
+  }
+  m.Busy[Ep] = FALSE;
+  m.Resource[Ep] = 0;
+  *Length = m.Requested[Ep] - Left;
+  return TRUE;
+}
+
+STATIC VOID ArmSetup (VOID)
+{
+  m.Phase = SetupPhase;
+  Transfer (0, SETUP_OFFSET, 8, T_SETUP);
+}
+
+STATIC VOID StallControl (VOID)
+{
+  if (Command (0, SET_STALL, 0, 0, 0)) {
+    ArmSetup ();
+  }
+}
+
+STATIC VOID Configure (VOID)
+{
+  if (m.Status.Configured || m.Status.Failed) {
+    return;
+  }
+  if (!Command (0, START_CONFIG | (2U << 16), 0, 0, 0) ||
+      !Command (2, SET_CONFIG, (2U << 1) | ((UINT32)m.MaxPacket << 3), (1U << 8) | (2U << 25), 0) ||
+      !Command (2, SET_RESOURCE, 1, 0, 0) ||
+      !Command (3, SET_CONFIG, (2U << 1) | ((UINT32)m.MaxPacket << 3) | (1U << 17), (1U << 8) | (3U << 25), 0) ||
+      !Command (3, SET_RESOURCE, 1, 0, 0) ||
+      !Command (5, SET_CONFIG, (3U << 1) | (16U << 3) | (2U << 17), (1U << 8) | (8U << 16) | (5U << 25), 0) ||
+      !Command (5, SET_RESOURCE, 1, 0, 0)) {
+    return;
+  }
+  WriteUsb (DALEPENA, 3U | (1U << 2) | (1U << 3) | (1U << 5));
+  m.Status.Configured = TRUE;
+  Transfer (2, RX_OFFSET, RX_BYTES, T_NORMAL);
+  Message ("K70 XNU USB: CDC configured; awaiting host DTR");
+}
+
+STATIC UINTN StringDescriptor (UINTN Index, UINT8 *Data)
+{
+  UINTN Size;
+  CONST CHAR8 *Text;
+  if (Index == 0) {
+    Data[0] = 4; Data[1] = 3; Data[2] = 9; Data[3] = 4;
+    return 4;
+  }
+  if (Index >= ARRAY_SIZE (mStrings)) {
+    return 0;
+  }
+  Size = 2;
+  for (Text = mStrings[Index]; (*Text != 0) && (Size < 126); Text++) {
+    Data[Size++] = (UINT8)*Text;
+    Data[Size++] = 0;
+  }
+  Data[0] = (UINT8)Size;
+  Data[1] = 3;
+  return Size;
+}
+
+STATIC VOID HandleSetup (VOID)
+{
+  CONST UINT8 *Setup;
+  UINT8 *Data;
+  UINTN Value;
+  UINTN Index;
+  UINTN Length;
+  UINTN Size = 0;
+  UINTN Pos;
+  UINTN Packet;
+  BOOLEAN Recognized = TRUE;
+  BOOLEAN OldDtr;
+  ReadDma (SETUP_OFFSET, 64);
+  Setup = m.Dma + SETUP_OFFSET;
+  Data = m.Dma + DATA_OFFSET;
+  Value = Setup[2] | ((UINTN)Setup[3] << 8);
+  Index = Setup[4] | ((UINTN)Setup[5] << 8);
+  Length = Setup[6] | ((UINTN)Setup[7] << 8);
+  m.Status.Setups++;
+  m.DataIn = (Setup[0] & 0x80) != 0;
+  m.SetLine = FALSE;
+  if ((Setup[0] == 0x80) && (Setup[1] == 6)) {
+    switch (Value >> 8) {
+      case 1:
+        if ((Value & 255U) == 0) { CopyMem (Data, mDevice, sizeof (mDevice)); Size = sizeof (mDevice); }
+        break;
+      case 2:
+      case 7:
+        if ((Value & 255U) != 0) { break; }
+        CopyMem (Data, mConfiguration, sizeof (mConfiguration));
+        Size = sizeof (mConfiguration);
+        Data[1] = (UINT8)(Value >> 8);
+        for (Pos = 0; Pos < Size; Pos += Data[Pos]) {
+          if ((Data[Pos + 1] == 5) && ((Data[Pos + 3] & 3U) == 2)) {
+            Packet = (Value >> 8) == 7 ? (m.MaxPacket == 512 ? 64 : 512) : m.MaxPacket;
+            Data[Pos + 4] = (UINT8)Packet;
+            Data[Pos + 5] = (UINT8)(Packet >> 8);
+          }
+        }
+        break;
+      case 3:
+        Size = StringDescriptor (Value & 255U, Data);
+        break;
+      case 6:
+        if ((Value & 255U) == 0) { CopyMem (Data, mQualifier, sizeof (mQualifier)); Size = sizeof (mQualifier); }
+        break;
+      default:
+        break;
+    }
+    if (Size == 0) { Recognized = FALSE; }
+  } else if ((Setup[0] == 0) && (Setup[1] == 5) && (Index == 0) && (Length == 0) && (Value < 128)) {
+    WriteUsb (DCFG, (ReadUsb (DCFG) & ~(127U << 3)) | ((UINT32)Value << 3));
+  } else if ((Setup[0] == 0) && (Setup[1] == 9) && (Index == 0) && (Length == 0) && (Value <= 1)) {
+    if ((Value == 0) && m.Status.Configured) {
+      Fail (EFI_ABORTED, "K70 XNU USB: host deconfigured; no automatic restart");
+      return;
+    }
+    if (Value != 0) { Configure (); }
+  } else if ((Setup[0] == 0x80) && (Setup[1] == 8) && (Value == 0) && (Index == 0) && (Length == 1)) {
+    Data[0] = m.Status.Configured ? 1 : 0; Size = 1;
+  } else if (((Setup[0] == 0x80) || (Setup[0] == 0x81) || (Setup[0] == 0x82)) &&
+             (Setup[1] == 0) && (Value == 0) && (Length == 2)) {
+    Data[0] = 0; Data[1] = 0; Size = 2;
+  } else if ((Setup[0] == 1) && (Setup[1] == 11) && (Index <= 1) && (Value == 0) && (Length == 0)) {
+    /* Both interfaces expose only alternate setting zero. */
+  } else if ((Setup[0] == 0x81) && (Setup[1] == 10) && (Index <= 1) && (Value == 0) && (Length == 1)) {
+    Data[0] = 0; Size = 1;
+  } else if ((Setup[0] == 0x21) && (Setup[1] == 0x20) && (Index == 0) && (Value == 0) && (Length == 7)) {
+    m.SetLine = TRUE;
+  } else if ((Setup[0] == 0xA1) && (Setup[1] == 0x21) && (Index == 0) && (Value == 0) && (Length == 7)) {
+    CopyMem (Data, m.LineCoding, 7); Size = 7;
+  } else if ((Setup[0] == 0x21) && (Setup[1] == 0x22) && (Index == 0) && (Length == 0) && ((Value & ~3U) == 0)) {
+    if (m.Status.Configured) {
+      OldDtr = m.Status.Dtr;
+      m.Status.Dtr = (Value & 1U) != 0;
+      m.Notify = TRUE;
+      if (m.Status.Dtr && !OldDtr) {
+        m.Cursor = 0;
+        m.CursorGeneration++;
+        Message ("K70 XNU USB: receiver opened; retained report then live log");
+      }
+    }
+  } else if ((Setup[0] == 0x21) && (Setup[1] == 0x23) && (Index == 0) && (Length == 0)) {
+    /* SEND_BREAK is acknowledged; it never controls the application. */
+  } else if ((Setup[0] == 2) && (Setup[1] == 1) && (Value == 0) && (Length == 0) &&
+             ((Index == 1) || (Index == 0x81) || (Index == 0x82))) {
+    Pos = (Index & 15U) * 2U + ((Index >> 7) & 1U);
+    if (m.Busy[Pos]) {
+      Fail (EFI_ABORTED, "K70 XNU USB: clear halt on active endpoint; no replay");
+      return;
+    }
+    (VOID)Command (Pos, CLEAR_STALL, 0, 0, 0);
+  } else {
+    Recognized = FALSE;
+  }
+  if (m.Status.Failed) { return; }
+  if (!Recognized) { StallControl (); return; }
+  if (Length == 0) { m.Phase = WaitTwoStage; return; }
+  m.Phase = DataPhase;
+  if (m.DataIn) {
+    Transfer (1, DATA_OFFSET, Size < Length ? Size : Length, T_DATA);
+  } else if (m.SetLine) {
+    Transfer (0, DATA_OFFSET, 64, T_DATA);
+  } else {
+    StallControl ();
+  }
+}
+
+STATIC VOID Transmit (VOID)
+{
+  STATIC CONST UINT8 Notification[10] = { 0xA1, 0x20, 0, 0, 0, 0, 2, 0, 3, 0 };
+  UINTN Bytes;
+  UINT64 Cursor;
+  if (!m.Status.Configured || !m.Status.Dtr || m.Status.Failed) {
+    return;
+  }
+  if (m.Notify && !m.Busy[5]) {
+    CopyMem (m.Dma + NOTIFY_OFFSET, Notification, sizeof (Notification));
+    m.Notify = FALSE;
+    Transfer (5, NOTIFY_OFFSET, sizeof (Notification), T_NORMAL);
+  }
+  if (m.Status.Failed || m.Busy[3]) { return; }
+  Cursor = m.Cursor;
+  Bytes = m.CopyLog (&Cursor, m.Dma + TX_OFFSET, TX_BYTES);
+  if ((Bytes > TX_BYTES) || ((Bytes != 0) && (Cursor < Bytes))) {
+    Fail (EFI_COMPROMISED_DATA, "K70 XNU USB: log-copy callback bounds error");
+    return;
+  }
+  if ((Bytes != 0) && ((Bytes % m.MaxPacket) == 0)) {
+    Bytes--; Cursor--;
+  }
+  if (Bytes != 0) {
+    m.PendingCursor = Cursor;
+    m.PendingGeneration = m.CursorGeneration;
+    m.PendingBytes = Bytes;
+    Transfer (3, TX_OFFSET, Bytes, T_NORMAL);
+  }
+}
+
+STATIC VOID HandleEvent (UINT32 Event)
+{
+  UINTN Type;
+  UINTN Ep;
+  UINTN Status;
+  UINTN Bytes;
+  UINTN Speed;
+  UINTN Direction;
+  UINT32 Kind;
+  if ((Event & 1U) != 0) {
+    if ((Event & 0xFEU) != 0) {
+      Fail (EFI_DEVICE_ERROR, "K70 XNU USB: unexpected device event format"); return;
+    }
+    Type = (Event >> 8) & 15U;
+    if (Type == 1) {
+      if (m.Status.Configured) {
+        Fail (EFI_ABORTED, "K70 XNU USB: configured bus reset; no automatic restart"); return;
+      }
+      WriteUsb (DCFG, ReadUsb (DCFG) & ~(127U << 3));
+    } else if (Type == 2) {
+      Speed = ReadUsb (DSTS) & 7U;
+      if ((Speed != 0) && (Speed != 1) && (Speed != 3)) {
+        Fail (EFI_UNSUPPORTED, "K70 XNU USB: unexpected non-USB2 speed"); return;
+      }
+      m.MaxPacket = Speed == 0 ? 512 : 64;
+      if (!Command (0, SET_CONFIG, (64U << 3) | (2U << 30), (1U << 8) | (1U << 10), 0)) { return; }
+      (VOID)Command (1, SET_CONFIG, (64U << 3) | (2U << 30), (1U << 8) | (1U << 10) | (1U << 25), 0);
+    } else if ((Type == 0) && m.Status.Configured) {
+      Fail (EFI_ABORTED, "K70 XNU USB: cable disconnected; no automatic restart");
+    } else if ((Type == 9) || (Type == 11)) {
+      Fail (EFI_DEVICE_ERROR, "K70 XNU USB: controller/event overflow");
+    }
+    return;
+  }
+  Ep = (Event >> 1) & 31U;
+  Type = (Event >> 6) & 15U;
+  Status = (Event >> 12) & 15U;
+  if (Type == 1) {
+    if (!Complete (Ep, &Bytes)) { return; }
+    if ((Status & 1U) != 0) {
+      Fail (EFI_DEVICE_ERROR, "K70 XNU USB: transfer bus error"); return;
+    }
+    if (Ep == 2) {
+      ReadDma (RX_OFFSET, RX_BYTES);
+      m.Status.RxBytes += Bytes;
+      control_receive(m.Dma + RX_OFFSET, (unsigned)Bytes); /* Frame/queue only. */
+      Transfer (2, RX_OFFSET, RX_BYTES, T_NORMAL);
+      return;
+    }
+    if (Ep == 3) {
+      if (!K70UsbCommitPending (&m.Cursor, m.CursorGeneration, m.PendingGeneration,
+             m.PendingCursor, m.PendingBytes, Bytes, !m.Status.Failed && m.Status.Running)) {
+        Fail (EFI_DEVICE_ERROR, "K70 XNU USB: incomplete bulk-IN; cursor not committed"); return;
+      }
+      m.PendingBytes = 0;
+      m.Status.TxBytes += Bytes;
+      return;
+    }
+    if (Ep > 1) { return; }
+    switch (m.Phase) {
+      case SetupPhase:
+        if ((Ep != 0) || (Bytes != 8)) { Fail (EFI_DEVICE_ERROR, "K70 XNU USB: setup length"); }
+        else { HandleSetup (); }
+        break;
+      case DataPhase:
+        if (m.SetLine) {
+          if ((Ep != 0) || (Bytes != 7)) { Fail (EFI_DEVICE_ERROR, "K70 XNU USB: line coding length"); break; }
+          ReadDma (DATA_OFFSET, 64);
+          CopyMem (m.LineCoding, m.Dma + DATA_OFFSET, 7);
+        }
+        m.Phase = WaitThreeStage;
+        break;
+      case StatusPhase:
+        ArmSetup ();
+        break;
+      default:
+        Fail (EFI_DEVICE_ERROR, "K70 XNU USB: control completion order");
+        break;
+    }
+  } else if ((Ep <= 1) && (Type == 3) && (Status == 2) &&
+             ((m.Phase == WaitTwoStage) || (m.Phase == WaitThreeStage))) {
+    Direction = m.Phase == WaitTwoStage ? 1 : (m.DataIn ? 0 : 1);
+    if (Ep != Direction) { Fail (EFI_DEVICE_ERROR, "K70 XNU USB: control status direction"); return; }
+    Kind = m.Phase == WaitThreeStage ? T_STATUS3 : T_STATUS2;
+    m.Phase = StatusPhase;
+    Transfer (Ep, DATA_OFFSET, 0, Kind);
+  }
+}
+
+STATIC BOOLEAN CheckSmmu (VOID)
+{
+  UINTN Index;
+  UINTN Cb;
+  UINT32 Smr;
+  UINT32 Route = 0;
+  UINT32 ExactSmr = 0;
+  UINT32 BroadSmr = 0;
+  CHAR8 Line[192];
+  m.Status.SmmuId0 = ReadAt (SMMU_BASE, 0x20);
+  m.Status.SmmuId1 = ReadAt (SMMU_BASE, 0x24);
+  m.Status.SmmuControl = ReadAt (SMMU_BASE, 0);
+  m.Status.SmmuId2 = ReadAt (SMMU_BASE, 0x28);
+  m.Status.ValidFields |= K70_USB_VALID_SMMU;
+  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: SMMU ID0=%08x ID1=%08x CR0=%08x ID2=%08x",
+    m.Status.SmmuId0, m.Status.SmmuId1, m.Status.SmmuControl, m.Status.SmmuId2);
+  Message (Line);
+  if ((m.Status.SmmuId0 != 0x4C017E69U) || (m.Status.SmmuId1 != 0x60000046U) ||
+      (m.Status.SmmuControl != 0x00280406U) || (m.Status.SmmuId2 != 0x5111U)) {
+    Fail (EFI_UNSUPPORTED, "K70 XNU USB: SMMU ID/control mismatch; controller untouched");
+    return FALSE;
+  }
+  for (Index = 0; Index < 105; Index++) {
+    Smr = ReadAt (SMMU_BASE, 0x800 + 4 * Index);
+    if (!K70UsbStreamCovers40 (Smr)) { continue; }
+    if (!K70UsbExactStream40 (Smr)) {
+      m.Status.BroadMatches++;
+      if (BroadSmr == 0) { BroadSmr = Smr; }
+      continue; /* Count all overlaps, never accept a broad match. */
+    }
+    m.Status.ExactMatches++;
+    ExactSmr = Smr;
+    Route = ReadAt (SMMU_BASE, 0xC00 + 4 * Index);
+  }
+  m.Status.ValidFields |= K70_USB_VALID_SCAN;
+  m.Status.SmmuSmr = m.Status.BroadMatches != 0 ? BroadSmr : ExactSmr;
+  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: SID40 exact=%u broad=%u SMR=%08x route=%08x",
+    m.Status.ExactMatches, m.Status.BroadMatches, m.Status.SmmuSmr, Route);
+  Message (Line);
+  if ((m.Status.BroadMatches != 0) || (m.Status.ExactMatches != 1)) {
+    AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: SID40 refused: exact=%u broad=%u SMR=%08x; untouched",
+      m.Status.ExactMatches, m.Status.BroadMatches, m.Status.SmmuSmr);
+    Fail (EFI_UNSUPPORTED, Line);
+    return FALSE;
+  }
+  m.Status.SmmuRoute = Route;
+  m.Status.ValidFields |= K70_USB_VALID_ROUTE;
+  m.Status.SmmuCbar = 0;
+  m.Status.SmmuSctlr = 1;
+  if (((Route >> 16) & 3U) == 0) {
+    Cb = Route & 255U;
+    if (Cb >= 70) {
+      Fail (EFI_UNSUPPORTED, "K70 XNU USB: SID40 context bank out of known bounds; untouched"); return FALSE;
+    }
+    m.Status.SmmuCbar = ReadAt (SMMU_BASE, 0x1000 + 4 * Cb);
+    m.Status.SmmuSctlr = ReadAt (SMMU_BASE, 0x80000 + 0x1000 * Cb);
+    m.Status.ValidFields |= K70_USB_VALID_CONTEXT;
+  }
+  if (!K70UsbRouteIdentity (Route, m.Status.SmmuCbar, m.Status.SmmuSctlr)) {
+    AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: SID40 not identity: route=%08x CBAR=%08x SCTLR=%08x",
+      Route, m.Status.SmmuCbar, m.Status.SmmuSctlr);
+    Fail (EFI_UNSUPPORTED, Line);
+    return FALSE;
+  }
+  return TRUE;
+}
+
+STATIC EFI_STATUS K70UsbCdcInitialize (K70_USB_COPY_LOG CopyLog, K70_USB_LOG_MESSAGE LogMessage)
+{
+  EFI_STATUS Status;
+  UINT32 Hardware;
+  UINT64 Ctr;
+  UINTN Count;
+  CHAR8 Line[192];
+  if ((CopyLog == NULL) || (LogMessage == NULL)) { return EFI_INVALID_PARAMETER; }
+  if (m.Attempted) { return EFI_ALREADY_STARTED; }
+  m.Attempted = TRUE;
+  m.CopyLog = CopyLog;
+  m.LogMessage = LogMessage;
+  m.Status.LastStatus = EFI_NOT_READY;
+  m.Status.ShutdownStatus = EFI_NOT_STARTED;
+  m.MaxPacket = 512;
+  m.LineCoding[1] = 0xC2; m.LineCoding[2] = 1; m.LineCoding[6] = 8;
+  Message ("K70 XNU USB: kernel-owned CDC K70XNU001; log-only; no commands");
+  Status = MapKernelDevices ();
+  if (EFI_ERROR (Status)) {
+    Fail (Status, "K70 XNU: kernel device ioremap failed; untouched");
+    return Status;
+  }
+  __asm__ __volatile__ ("mrs %0, ctr_el0" : "=r" (Ctr));
+  m.Status.CacheLineBytes = 4U << ((Ctr >> 16) & 15U);
+  m.Status.ValidFields |= K70_USB_VALID_CACHE;
+  if ((m.Status.CacheLineBytes == 0) || (m.Status.CacheLineBytes > 64) ||
+      ((m.Status.CacheLineBytes & (m.Status.CacheLineBytes - 1U)) != 0)) {
+    Fail (EFI_UNSUPPORTED, "K70 XNU USB: cache line exceeds independent 64-byte DMA slots; untouched");
+    return m.Status.LastStatus;
+  }
+  m.Status.GccPower = ReadAt (GCC_BASE, 4);
+  m.Status.GccMaster = ReadAt (GCC_BASE, 0x18);
+  m.Status.GccCfg = ReadAt (GCC_BASE, 0x88);
+  m.Status.GccAggre = ReadAt (GCC_BASE, 0x8C);
+  m.Status.ValidFields |= K70_USB_VALID_GCC;
+  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: GCC power=%08x master=%08x cfg=%08x aggre=%08x",
+    m.Status.GccPower, m.Status.GccMaster, m.Status.GccCfg, m.Status.GccAggre);
+  Message (Line);
+  if (!K70UsbGccReady (m.Status.GccPower, m.Status.GccMaster, m.Status.GccCfg, m.Status.GccAggre)) {
+    Fail (EFI_NOT_READY, "K70 XNU USB: ABL clock/power state unavailable; controller untouched");
+    return m.Status.LastStatus;
+  }
+  m.Status.SnpsId = ReadUsb (0xC120);
+  Hardware = ReadUsb (0xC140);
+  m.Status.DmaAddressWidth = Hardware >> 24;
+  m.Status.Gctl = ReadUsb (GCTL);
+  m.Status.ValidFields |= K70_USB_VALID_CONTROLLER;
+  if ((((m.Status.SnpsId >> 16) != 0x5533) && ((m.Status.SnpsId >> 16) != 0x3331)) ||
+      (((m.Status.Gctl >> 12) & 3U) != 2) ||
+      (m.Status.DmaAddressWidth < 32) || (m.Status.DmaAddressWidth > 64)) {
+    Fail (EFI_UNSUPPORTED, "K70 XNU USB: controller ID/device role/AWIDTH refused; untouched");
+    return m.Status.LastStatus;
+  }
+  if (!CheckSmmu ()) { return m.Status.LastStatus; }
+  m.Status.DstsBefore = ReadUsb (DSTS);
+  m.Status.DctlBefore = ReadUsb (DCTL);
+  m.Status.DstsAfter = ReadUsb (DSTS);
+  m.Status.ValidFields |= K70_USB_VALID_IDLE;
+  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: idle DSTS=%08x DCTL=%08x DSTS=%08x",
+    m.Status.DstsBefore, m.Status.DctlBefore, m.Status.DstsAfter);
+  Message (Line);
+  if (((m.Status.DstsBefore & HALTED) == 0) || ((m.Status.DstsAfter & HALTED) == 0) ||
+      ((m.Status.DctlBefore & RUN) != 0)) {
+    Fail (EFI_NOT_READY, "K70 XNU USB: ABL controller is active/non-idle; controller untouched");
+    return m.Status.LastStatus;
+  }
+  Status = AllocateDma ();
+  if (EFI_ERROR (Status)) {
+    Fail (Status, "K70 XNU USB: owned kernel BSS DMA validation failed; untouched");
+    return Status;
+  }
+  AsciiSPrint (Line, sizeof (Line), "K70 XNU USB: DMA kernel BSS %llx+%x, contiguous owned pages, AWIDTH=%u",
+    (unsigned long long)m.Status.DmaAddress, K70_USB_DMA_SIZE, m.Status.DmaAddressWidth);
+  Message (Line);
+  m.ControllerTouched = TRUE;
+  Status = StopEngine ();
+  if (EFI_ERROR (Status)) {
+    Fail (Status, "K70 XNU USB: initial controller halt timeout"); return Status;
+  }
+  WriteUsb (DCTL, RESET);
+  for (Count = 0; Count < HALT_POLLS; Count++) {
+    if ((ReadUsb (DCTL) & RESET) == 0) { break; }
+    MicroSecondDelay (1000);
+  }
+  if ((ReadUsb (DCTL) & RESET) != 0) {
+    Fail (EFI_TIMEOUT, "K70 XNU USB: controller reset timeout"); return EFI_TIMEOUT;
+  }
+  WriteUsb (GEVNTADRLO, (UINT32)m.Status.DmaAddress);
+  WriteUsb (GEVNTADRHI, (UINT32)(m.Status.DmaAddress >> 32));
+  WriteUsb (GEVNTSIZ, (1U << 31) | EVENT_BYTES);
+  if ((ReadUsb (GEVNTADRLO) != (UINT32)m.Status.DmaAddress) ||
+      (ReadUsb (GEVNTADRHI) != (UINT32)(m.Status.DmaAddress >> 32)) ||
+      (ReadUsb (GEVNTSIZ) != ((1U << 31) | EVENT_BYTES))) {
+    Fail (EFI_DEVICE_ERROR, "K70 XNU USB: event DMA LO/HI/size readback mismatch"); return EFI_DEVICE_ERROR;
+  }
