+    if ((ReadUsb (DSTS) & HALTED) == 0) { break; }
+    MicroSecondDelay (1000);
+  }
+  if ((ReadUsb (DSTS) & HALTED) != 0) {
+    Fail (EFI_TIMEOUT, "K70 XNU USB: controller run timeout"); return EFI_TIMEOUT;
+  }
