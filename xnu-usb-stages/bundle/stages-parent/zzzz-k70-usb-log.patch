+      !Command (0, SET_CONFIG, 64U << 3, (1U << 8) | (1U << 10), 0) || !Command (0, SET_RESOURCE, 1, 0, 0) ||
+      !Command (1, SET_CONFIG, 64U << 3, (1U << 8) | (1U << 10) | (1U << 25), 0) || !Command (1, SET_RESOURCE, 1, 0, 0)) {
+    return m.Status.LastStatus;
+  }
+  WriteUsb (DALEPENA, 3);
+  ArmSetup ();
+  if (m.Status.Failed) { return m.Status.LastStatus; }
+  m.OriginalHsOverride = ReadAt (QSCRATCH_BASE, 0x10);
+  m.OriginalSsOverride = ReadAt (QSCRATCH_BASE, 0x30);
+  m.OverrideWritten = TRUE;
+  WriteAt (QSCRATCH_BASE, 0x10, m.OriginalHsOverride | (1U << 20) | (1U << 28));
+  WriteAt (QSCRATCH_BASE, 0x30, m.OriginalSsOverride | (1U << 24));
